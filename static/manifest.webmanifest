{
  "name": "Notes & Reminders",
  "short_name": "Notes",
  "description": "Private local notes, checklists and reminders.",
  "id": "/notes-app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080c17",
  "theme_color": "#0b1020",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "url": "/new"
    },
    {
      "name": "Today",
      "short_name": "Today",
      "url": "/?view=notes&focus=today"
    }
  ]
}
